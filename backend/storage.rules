rules_version = '2';

// ============================================================
//  REGLAS DE CLOUD STORAGE  ·  YES EMS
//  ------------------------------------------------------------
//  Sustituyen a las políticas del bucket "pdfs" de Supabase.
//  Al cambiar la lista de administradores, actualiza también
//  firestore.rules y frontend/js/config/firebase.js.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'raulyeyo12@gmail.com',
             'raulgarciarivera08@gmail.com'
           ];
    }

    // Guías y material del curso.
    match /pdfs/{archivo} {
      // Lectura pública: los enlaces de descarga se comparten con los alumnos.
      allow read: if true;

      // Solo el admin sube o reemplaza, y solo PDFs de hasta 25 MB.
      allow write: if esAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    // Cualquier otra ruta queda cerrada.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
