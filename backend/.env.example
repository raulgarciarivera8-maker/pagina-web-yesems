# Copia este archivo como .env para desarrollo local.
# En Render, estos valores van en Settings → Environment.
# NUNCA subas el .env real al repositorio.

# --- Base de datos ---
# Atlas → Connect → Drivers. Recuerda permitir 0.0.0.0/0 en Network Access.
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=yesems

# --- Sesiones ---
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si lo cambias, todas las sesiones abiertas se cierran.
JWT_SECRET=

# --- URLs ---
SITE_URL=https://pagina-web-yesems.vercel.app
API_URL=https://yesems-api.onrender.com

# --- Administradores (separados por coma) ---
ADMIN_EMAILS=raulyeyo12@gmail.com,raulgarciarivera08@gmail.com

# --- Correo ---
# SendGrid → Settings → API Keys, permiso "Mail Send". Empieza con SG.
SENDGRID_API_KEY=
# Debe estar verificado en SendGrid → Sender Authentication.
MAIL_FROM=contacto@yesems.mx

# --- Pagos ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
